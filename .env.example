# ==============================================================================
# InspectAgent Environment Configuration Example
# Copy this file to .env and adjust variables as needed:
#   copy .env.example .env
# ==============================================================================

# Server Environment: 'local' | 'cloudrun' | 'production'
ENVIRONMENT=local
HOST=0.0.0.0
PORT=8000

# Gemini AI Agent Model Configuration
# Required model specified by project: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

# Storage & Dataset Paths (Relative to project root or Absolute path)
# Default expects MVTec AD Bottle dataset in dataset/bottle
DATASET_PATH=dataset/bottle
OUTPUT_DIR=data/outputs
LOG_DIR=data/logs

# Image Quality Thresholds (Configurable)
# Normal bottle brightness mean is ~136.3 (p1: 133.5, p99: 139.5)
BRIGHTNESS_LOW_THRESHOLD=125.0
BRIGHTNESS_HIGH_THRESHOLD=150.0
FAULT_INJECTION_FACTOR=0.6

# ROI PostgreSQL administration (local-only; separate from capture sessions)
# scripts/setup_roi_database.py prepare generates ignored .env.roi-db.local.
# Replace placeholders locally; never commit real passwords or tokens.
VISIONINSIGHT_DATABASE_URL=postgresql+psycopg://vi_roi_app:<password>@127.0.0.1:55432/visioninsight_roi
VISIONINSIGHT_MIGRATION_URL=postgresql+psycopg://vi_roi_migrator:<password>@127.0.0.1:55432/visioninsight_roi
VISIONINSIGHT_TEST_DATABASE_URL=postgresql+psycopg://vi_roi_test:<password>@127.0.0.1:55432/visioninsight_roi_test
VISIONINSIGHT_ROI_ADMIN_TOKEN=<random-url-safe-token-at-least-32-characters>
VISIONINSIGHT_ROI_PRODUCT_IDS=<explicitly-registered-neutral-product-ids-separated-by-commas>
VISIONINSIGHT_ROI_MIN_SIZE=32
VISIONINSIGHT_ROI_ENVIRONMENT=local
VISIONINSIGHT_ROI_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
