# ==============================================================================
# InspectAgent Environment Configuration Example
# Copy this file to .env and adjust variables as needed:
#   copy .env.example .env
# ==============================================================================

# Server Environment: 'local' | 'cloudrun' | 'production'
ENVIRONMENT=local
HOST=0.0.0.0
PORT=8000

# Gemini AI Agent Model Configuration
# Required model specified by project: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

# Storage & Dataset Paths (Relative to project root or Absolute path)
# Default expects MVTec AD Bottle dataset in dataset/bottle
DATASET_PATH=dataset/bottle
OUTPUT_DIR=data/outputs
LOG_DIR=data/logs

# Image Quality Thresholds (Configurable)
# Normal bottle brightness mean is ~136.3 (p1: 133.5, p99: 139.5)
BRIGHTNESS_LOW_THRESHOLD=125.0
BRIGHTNESS_HIGH_THRESHOLD=150.0
FAULT_INJECTION_FACTOR=0.6
